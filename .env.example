# Paths to model artifacts (relative to where you run uvicorn)
CLASSIFIER_PATH=./artifacts/querymind_ambiguity_classifier.joblib
T5_MODEL_DIR=./artifacts/QueryMind_Experiment3_T5_Conversational
REWRITER_DIR=./artifacts/querymind_rewriter

# Table retriever (downloaded automatically on first start)
RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# auto = use the GPU if there is one, else CPU
MODEL_DEVICE=auto

# Classifier confidence gate (provisional)
MIN_TOP_PROBABILITY=0.65
MIN_PROBABILITY_MARGIN=0.00

# Number of SQL candidates (beams) tried per question
SQL_NBEST=4
# Set to 0 to stop falling back to the next candidate when a query returns no rows
EXEC_FALLBACK=1

# The database connection string is entered in the app (never stored here).
CONNECTION_STRING = postgresql://postgres:YOUR_PASSWORD@localhost:5432/college_db
